# ==========================================
# Database Credentials (PostgreSQL Container)
# ==========================================
POSTGRES_USER=onlinejudge_user
POSTGRES_PASSWORD=SuperSecretSecurePassword123!
POSTGRES_DB=onlinejudge_db

# ==========================================
# App Database Connection Settings
# ==========================================
# MUST match the service name in docker-compose.yml!
DB_HOST=postgres-db
DB_PORT=5432

# ==========================================
# Cloudflare Tunnel Token
# ==========================================
CLOUDFLARE_TUNNEL_TOKEN=cloudflare_tunnel_token